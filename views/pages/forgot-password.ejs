<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main>
  <section class="auth-section">
    <div class="auth-card">
      <div class="auth-logo">
        <img src="/images/logo_nav.png" alt="Con Leche" />
      </div>
      <h1 class="auth-title">Forgot Password</h1>

      <!-- Step 1: email -->
      <div id="fpEmailStep" class="fp-step">
        <p class="auth-sub">Enter your email and we'll send you a verification code.</p>
        <p class="auth-error hidden" id="fpEmailError"></p>
        <form id="fpEmailForm" class="auth-form">
          <div class="form-group">
            <label for="fpEmail">Email</label>
            <input type="email" id="fpEmail" name="email" required placeholder="you@example.com" autofocus />
          </div>
          <button type="submit" class="btn btn-primary btn-full">Send code</button>
        </form>
      </div>

      <!-- Step 2: OTP -->
      <div id="fpOtpStep" class="fp-step bp-otp-step hidden">
        <p class="auth-sub">Enter the 6-digit code we sent you.</p>
        <div class="bp-otp-row">
          <input type="text" id="fpOtpInput" class="bp-otp-input" inputmode="numeric" maxlength="6" placeholder="000000" />
          <button class="btn btn-primary bp-otp-submit" id="fpOtpSubmit">Verify</button>
        </div>
        <p class="auth-error hidden" id="fpOtpError"></p>
        <button class="bp-otp-resend" id="fpOtpResend">Resend code</button>
      </div>

      <!-- Step 3: new password -->
      <div id="fpPasswordStep" class="fp-step hidden">
        <p class="auth-sub">Choose a new password.</p>
        <p class="auth-error hidden" id="fpPasswordError"></p>
        <form id="fpPasswordForm" class="auth-form">
          <div class="form-group">
            <label for="fpNewPassword">New Password</label>
            <input type="password" id="fpNewPassword" name="password" required placeholder="8+ characters" minlength="8" autofocus />
          </div>
          <div class="form-group">
            <label for="fpConfirmPassword">Confirm Password</label>
            <input type="password" id="fpConfirmPassword" name="confirmPassword" required placeholder="••••••••" />
          </div>
          <button type="submit" class="btn btn-primary btn-full">Update password</button>
        </form>
      </div>

      <!-- Step 4: done -->
      <div id="fpDoneStep" class="fp-step hidden" style="text-align:center;">
        <p style="font-size:2rem;margin-bottom:0.5rem;">✓</p>
        <p class="auth-sub">Your password has been updated.</p>
        <button class="btn btn-primary btn-full" id="fpCloseBtn" style="margin-top:1rem;">Close</button>
        <p class="auth-switch" style="margin-top:0.75rem;">or <a href="/login">return to sign in</a></p>
      </div>

      <p class="auth-switch" id="fpBackToSignIn"><a href="/login">← Back to sign in</a></p>
    </div>
  </section>
</main>

<script>
(function () {
  var emailStep    = document.getElementById('fpEmailStep');
  var emailForm    = document.getElementById('fpEmailForm');
  var emailInput   = document.getElementById('fpEmail');
  var emailErr     = document.getElementById('fpEmailError');

  var otpStep      = document.getElementById('fpOtpStep');
  var otpInput     = document.getElementById('fpOtpInput');
  var otpSubmit    = document.getElementById('fpOtpSubmit');
  var otpResend    = document.getElementById('fpOtpResend');
  var otpErr       = document.getElementById('fpOtpError');

  var passwordStep = document.getElementById('fpPasswordStep');
  var passwordForm = document.getElementById('fpPasswordForm');
  var passwordErr  = document.getElementById('fpPasswordError');

  var doneStep      = document.getElementById('fpDoneStep');
  var backToSignIn  = document.getElementById('fpBackToSignIn');
  var closeBtn      = document.getElementById('fpCloseBtn');

  function showStep(step) {
    [emailStep, otpStep, passwordStep, doneStep].forEach(function (s) { s.classList.add('hidden'); });
    step.classList.remove('hidden');
    backToSignIn.classList.toggle('hidden', step === doneStep);
  }

  emailForm.addEventListener('submit', function (e) {
    e.preventDefault();
    emailErr.classList.add('hidden');
    var btn = emailForm.querySelector('button');
    btn.disabled = true; btn.textContent = 'Sending…';
    fetch('/forgot-password/request', { method: 'POST', body: new URLSearchParams({ email: emailInput.value }) })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        btn.disabled = false; btn.textContent = 'Send code';
        if (!json.ok) {
          emailErr.textContent = json.message || 'Something went wrong.';
          emailErr.classList.remove('hidden'); return;
        }
        showStep(otpStep);
        otpInput.value = '';
        otpInput.focus();
      });
  });

  function submitOtp() {
    otpErr.classList.add('hidden');
    otpSubmit.disabled = true; otpSubmit.textContent = 'Verifying…';
    fetch('/forgot-password/verify', { method: 'POST', body: new URLSearchParams({ code: otpInput.value }) })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        otpSubmit.disabled = false; otpSubmit.textContent = 'Verify';
        if (!json.ok) {
          otpErr.textContent = json.message || 'Incorrect code.';
          otpErr.classList.remove('hidden'); return;
        }
        showStep(passwordStep);
      });
  }
  otpSubmit.addEventListener('click', submitOtp);
  otpInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); submitOtp(); }
  });
  otpInput.addEventListener('input', function () {
    otpInput.value = otpInput.value.replace(/\D/g, '').slice(0, 6);
    if (otpInput.value.length === 6) submitOtp();
  });
  otpResend.addEventListener('click', function () {
    otpResend.disabled = true; otpResend.textContent = 'Sending…';
    fetch('/forgot-password/resend', { method: 'POST' })
      .then(function () {
        otpResend.textContent = 'Sent!';
        setTimeout(function () { otpResend.disabled = false; otpResend.textContent = 'Resend code'; }, 3000);
      });
  });

  passwordForm.addEventListener('submit', function (e) {
    e.preventDefault();
    passwordErr.classList.add('hidden');
    var btn = passwordForm.querySelector('button');
    btn.disabled = true; btn.textContent = 'Updating…';
    var body = new URLSearchParams(new FormData(passwordForm));
    fetch('/forgot-password/reset', { method: 'POST', body: body })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        btn.disabled = false; btn.textContent = 'Update password';
        if (!json.ok) {
          passwordErr.textContent = json.message || 'Something went wrong.';
          passwordErr.classList.remove('hidden'); return;
        }
        showStep(doneStep);
      });
  });

  closeBtn.addEventListener('click', function () {
    window.close();
  });
})();
</script>

<%- include('../partials/footer') %>
