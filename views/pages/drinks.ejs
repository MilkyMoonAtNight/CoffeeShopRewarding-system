<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main>
  <section class="page-hero page-hero-short section-dark">
    <div class="container" style="text-align:center;">
      <p class="section-eyebrow light">What We Pour</p>
      <h1 class="page-title light">The Drinks</h1>
    </div>
  </section>

  <div class="drinks-tabs-wrap">
    <div class="drinks-tabs">
      <button class="drinks-tab active" data-tab="hot">☕ Hot Drinks</button>
      <button class="drinks-tab" data-tab="cold">🧊 Cold Drinks</button>
    </div>
  </div>

  <section class="section drinks-section section-bloop">
    <div class="container">

      <!-- HOT -->
      <div class="drinks-panel" id="tab-hot">
        <div class="drinks-size-legend"><span>Sml — 250ml</span><span class="legend-sep">·</span><span>Lrg — 350ml</span><span class="legend-sep">·</span><span>Grande — soon</span></div>
        <div class="drink-grid">
          <% hot.forEach((drink, idx) => { %>
          <%
            const isLatte = drink.name && drink.name.toLowerCase().includes('latte');
            const dispFlavours = isLatte ? ['Plain','Vanilla','Hazelnut','Chocolate','Cinnamon','American Fudge','Caramel','Popcorn'] : (drink.flavours||[]);
          %>
          <div class="drink-card order-item-card <%= drink.isSpecial ? 'drink-card-special' : '' %>"
               data-drink-idx="<%= idx %>" data-drink-cat="hot">
            <div class="drink-card-inner-wrap">
              <div class="drink-card-media">
                <% if (drink.image && !drink.image.toLowerCase().endsWith('.svg')) { %>
                  <img src="<%= drink.image.startsWith('/') ? drink.image : '/images/drinks/' + drink.image %>" alt="<%= drink.name %>" loading="lazy" />
                <% } else { %>
                  <%- include('../partials/drink-panel', { drink: drink, textures: textures }) %>
                <% } %>
              </div>
              <div class="drink-card-scrim"></div>
              <span class="drink-name-center"><%= drink.name %></span>
              <% if (drink.isSpecial) { %><span class="drink-special-tag">✦ Special</span><% } %>
              <div class="drink-card-foot">
                <div class="drink-prices">
                  <% if (drink.prices&&drink.prices.regular) { %><span class="drink-price-pill">R<%= drink.prices.regular %><span class="drink-size-label"> sml</span></span><% } %>
                  <% if (drink.prices&&drink.prices.large)   { %><span class="drink-price-pill drink-price-large">R<%= drink.prices.large %><span class="drink-size-label"> lrg</span></span><% } %>
                  <% if (drink.prices&&drink.prices.grande)  { %><span class="drink-price-pill drink-price-grande">R<%= drink.prices.grande %><span class="drink-size-label"> grande</span></span><% } %>
                </div>
                <span class="order-add-hint">Tap to customise →</span>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% if (!hot.length) { %><p class="drinks-empty">Menu coming soon!</p><% } %>
      </div>

      <!-- COLD -->
      <div class="drinks-panel hidden" id="tab-cold">
        <div class="drinks-size-legend"><span>Sml — 350ml</span><span class="legend-sep">·</span><span>Lrg — 500ml</span><span class="legend-sep">·</span><span>Grande — soon</span></div>
        <div class="drink-grid">
          <% cold.forEach((drink, idx) => { %>
          <%
            const dn = (drink.name||'').toLowerCase();
            const LATTE_F  = ['Plain','Vanilla','Hazelnut','Chocolate','Cinnamon','American Fudge','Caramel','Popcorn'];
            const FREEZO_F = ['White Chocolate','Chai','Coffee','Chocolate','Salted Caramel'];
            const FY_F     = ['Plain','Vanilla','Hazelnut','Strawberry','Cherry','Litchi','Creamsoda'];
            const SLUSHI_F = ['Strawberry','Mango','Blue Raspberry','Watermelon','Grape'];
            const dispFlavours = dn.includes('frozen yogurt')||dn.includes('froyo') ? FY_F
                               : dn.includes('freezo')   ? FREEZO_F
                               : dn.includes('slush')    ? SLUSHI_F
                               : dn.includes('latte')    ? LATTE_F
                               : (drink.flavours||[]);
          %>
          <div class="drink-card order-item-card <%= drink.isSpecial ? 'drink-card-special' : '' %>"
               data-drink-idx="<%= idx %>" data-drink-cat="cold">
            <div class="drink-card-inner-wrap">
              <div class="drink-card-media">
                <% if (drink.image && !drink.image.toLowerCase().endsWith('.svg')) { %>
                  <img src="<%= drink.image.startsWith('/') ? drink.image : '/images/drinks/' + drink.image %>" alt="<%= drink.name %>" loading="lazy" />
                <% } else { %>
                  <%- include('../partials/drink-panel', { drink: drink, textures: textures }) %>
                <% } %>
              </div>
              <div class="drink-card-scrim"></div>
              <span class="drink-name-center"><%= drink.name %></span>
              <% if (drink.isSpecial) { %><span class="drink-special-tag">✦ Special</span><% } %>
              <div class="drink-card-foot">
                <div class="drink-prices">
                  <% if (drink.prices&&drink.prices.regular) { %><span class="drink-price-pill">R<%= drink.prices.regular %><span class="drink-size-label"> sml</span></span><% } %>
                  <% if (drink.prices&&drink.prices.large)   { %><span class="drink-price-pill drink-price-large">R<%= drink.prices.large %><span class="drink-size-label"> lrg</span></span><% } %>
                  <% if (drink.prices&&drink.prices.grande)  { %><span class="drink-price-pill drink-price-grande">R<%= drink.prices.grande %><span class="drink-size-label"> grande</span></span><% } %>
                </div>
                <span class="order-add-hint">Tap to customise →</span>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <% if (!cold.length) { %><p class="drinks-empty">Menu coming soon!</p><% } %>
      </div>

    </div>
  </section>

  <!-- Speciality drink advert — managed in /admin/advert -->
  <section class="section drinks-ad-section">
    <div class="container">
      <% if (ad && ad.image) { %>
        <% if (ad.link) { %><a href="<%= ad.link %>" class="drinks-ad" aria-label="<%= ad.caption || 'Speciality drink' %>"><% } else { %><div class="drinks-ad"><% } %>
          <img src="<%= ad.image %>" alt="<%= ad.caption || 'Speciality drink advert' %>" class="drinks-ad-img" loading="lazy" />
          <% if (ad.caption) { %><span class="drinks-ad-caption"><%= ad.caption %></span><% } %>
        <% if (ad.link) { %></a><% } else { %></div><% } %>
      <% } else { %>
        <div class="drinks-ad drinks-ad-placeholder">
          <span class="drinks-ad-ph-icon">✦</span>
          <span class="drinks-ad-ph-title">Speciality drink advert</span>
          <span class="drinks-ad-ph-sub">Upload a banner in the admin panel → Products → Advert</span>
        </div>
      <% } %>
    </div>
  </section>
</main>

<!-- Inject menu data for shared modal -->
<script>
window.CL_DATA = {
  loggedIn: <%= !!(locals.session && session.userId) %>,
  textures: <%- JSON.stringify(textures || {}).replace(/</g,"\\u003c") %>,
  hot: <%- JSON.stringify(hot.map(d => ({
    name:d.name, category:'hot', subcategory:d.subcategory, isSpecial:d.isSpecial,
    image:(d.image && !d.image.toLowerCase().endsWith('.svg'))?('/images/drinks/'+d.image):null,
    flavours:d.flavours||[], layers:d.layers||[],
    sizes:[
      d.prices&&d.prices.regular?{label:'Sml',   ml:(d.sizeLabels&&d.sizeLabels.regular)||'250ml',price:d.prices.regular}:null,
      d.prices&&d.prices.large  ?{label:'Lrg',   ml:(d.sizeLabels&&d.sizeLabels.large)  ||'350ml',price:d.prices.large  }:null,
      d.prices&&d.prices.grande ?{label:'Grande',ml:(d.sizeLabels&&d.sizeLabels.grande) ||'450ml',price:d.prices.grande }:null
    ].filter(Boolean)
  }))).replace(/</g,"\\u003c") %>,
  cold: <%- JSON.stringify(cold.map(d => ({
    name:d.name, category:'cold', subcategory:d.subcategory, isSpecial:d.isSpecial,
    image:(d.image && !d.image.toLowerCase().endsWith('.svg'))?('/images/drinks/'+d.image):null,
    flavours:d.flavours||[], layers:d.layers||[],
    sizes:[
      d.prices&&d.prices.regular?{label:'Sml',   ml:(d.sizeLabels&&d.sizeLabels.regular)||'350ml',price:d.prices.regular}:null,
      d.prices&&d.prices.large  ?{label:'Lrg',   ml:(d.sizeLabels&&d.sizeLabels.large)  ||'500ml',price:d.prices.large  }:null,
      d.prices&&d.prices.grande ?{label:'Grande',ml:(d.sizeLabels&&d.sizeLabels.grande) ||'650ml',price:d.prices.grande }:null
    ].filter(Boolean)
  }))).replace(/</g,"\\u003c") %>,
  pastries: []
};
</script>
<script src="/js/drink-panel.js"></script>

<%- include('../partials/item-modal') %>

<script>
document.querySelectorAll('.drinks-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.drinks-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.drinks-panel').forEach(p => p.classList.add('hidden'));
    tab.classList.add('active');
    document.getElementById('tab-' + tab.dataset.tab).classList.remove('hidden');
  });
});
</script>

<%- include('../partials/footer') %>
