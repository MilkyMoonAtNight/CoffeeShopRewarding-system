<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main>
<section class="bp-page">
  <div class="bp-container">

    <!-- ── INTERNAL NAV ── -->
    <div class="bp-tabs">
      <button class="bp-tab active" data-tab="profile">Profile</button>
      <button class="bp-tab" data-tab="rewards">Rewards</button>
      <button class="bp-tab" data-tab="history">History</button>
    </div>

    <!-- ════════════ TAB: PROFILE ════════════ -->
    <div class="bp-tab-panel" id="tab-profile">

      <div class="bp-qr-card">
        <div class="bp-card-logo">
          <img src="/images/logo_nav.png" alt="Con Leche" />
        </div>
        <h2 class="bp-name" id="bpNameDisplay"><%= user.name %></h2>
        <p class="bp-email"><%= user.email %></p>
        <div class="bp-qr-box">
          <img src="<%= qrDataUrl %>" alt="QR Code" class="bp-qr-img" />
        </div>

        <span style="display:block;height:0.75rem;"></span>

        <div class="bp-tier-chip">
          <%= user.tier === 'Kitten' ? '🐱' : user.tier === 'Cat' ? '🐈' : user.tier === 'Tom Cat' ? '😸' : '🐆' %>
          <%= user.tier %>
        </div>
        <p class="bp-qr-hint">Show this to your barista when ordering</p>

        <!-- Backup token — works even if the camera scan fails -->
        <div class="bp-token-box" onclick="copyToken()" title="Tap to copy">
          <span class="bp-token-label">Backup code — if scanning fails, the barista can type this:</span>
          <span class="bp-token" id="bpToken"><%= user.qrCode %></span>
          <span class="bp-token-copy" id="bpTokenCopy">tap to copy</span>
        </div>
      </div>

      <div class="bp-stats-row">
        <div class="bp-stat-box">
          <span class="bp-stat-num"><%= user.totalDrinks %></span>
          <span class="bp-stat-lbl">drinks</span>
        </div>
        <div class="bp-stat-box">
          <span class="bp-stat-num"><%= claimableItems.length %></span>
          <span class="bp-stat-lbl">to claim</span>
        </div>
        <div class="bp-stat-box">
          <span class="bp-stat-num"><%= activeVouchers.length %></span>
          <span class="bp-stat-lbl">vouchers</span>
        </div>
      </div>

      <!-- ── Edit Profile ── -->
      <div class="bp-section-card bp-profile-card">
        <div class="bp-profile-header">
          <p class="bp-section-label" style="margin:0;">Profile</p>
          <button class="bp-profile-edit-btn" id="bpProfileEditBtn">Edit profile &#9998;</button>
        </div>

        <!-- Display view -->
        <div id="bpProfileDisplay" class="bp-profile-display">
          <div class="bp-profile-row"><span class="bp-profile-lbl">Name</span><span class="bp-profile-val"><%= user.name %></span></div>
          <div class="bp-profile-row"><span class="bp-profile-lbl">Email</span><span class="bp-profile-val"><%= user.email %></span></div>
          <div class="bp-profile-row"><span class="bp-profile-lbl">Phone</span><span class="bp-profile-val" id="bpPhoneDisplay"><%= user.phone || '—' %></span></div>
        </div>

        <!-- Edit form -->
        <form id="bpProfileForm" class="bp-profile-form hidden" autocomplete="off">
          <div class="bp-pf-group">
            <label class="bp-pf-label" for="pfName">Name</label>
            <input type="text" id="pfName" name="name" class="bp-pf-input" value="<%= user.name %>"
                   pattern="[A-Za-z\s]+" maxlength="80" />
          </div>
          <div class="bp-pf-group">
            <label class="bp-pf-label" for="pfEmail">Email <span class="bp-pf-verify-note">· verification code required</span></label>
            <input type="email" id="pfEmail" name="email" class="bp-pf-input" value="<%= user.email %>" maxlength="200" />
          </div>
          <div class="bp-pf-group">
            <label class="bp-pf-label" for="pfPhone">Phone <span class="bp-pf-verify-note">· verification code required</span></label>
            <input type="tel" id="pfPhone" name="phone" class="bp-pf-input"
                   value="<%= user.phone || '' %>" maxlength="30" placeholder="e.g. 082 123 4567" />
          </div>
          <p class="bp-pf-error hidden" id="bpPfError"></p>
          <div class="bp-pf-actions" id="bpPfActions" style="display:none;">
            <button type="submit" class="btn btn-primary bp-pf-save">Save changes</button>
          </div>
        </form>

        <!-- Password change (nested toggle inside edit mode) -->
        <div id="bpPasswordSection" class="bp-pw-section hidden">
          <button type="button" class="bp-pw-toggle" id="bpPwToggle">Change password &#9998;</button>
          <form id="bpPasswordForm" class="bp-profile-form hidden" autocomplete="off">
            <div class="bp-pf-group">
              <label class="bp-pf-label" for="pfOldPassword">Current password</label>
              <input type="password" id="pfOldPassword" name="oldPassword" class="bp-pf-input" maxlength="200" autocomplete="current-password" />
              <a href="/forgot-password" class="bp-pw-forgot-link">Forgot password?</a>
            </div>
            <div class="bp-pf-group">
              <label class="bp-pf-label" for="pfNewPassword">New password</label>
              <input type="password" id="pfNewPassword" name="newPassword" class="bp-pf-input" minlength="8" maxlength="200" autocomplete="new-password" />
            </div>
            <div class="bp-pf-group">
              <label class="bp-pf-label" for="pfConfirmNewPassword">Confirm new password</label>
              <input type="password" id="pfConfirmNewPassword" name="confirmNewPassword" class="bp-pf-input" minlength="8" maxlength="200" autocomplete="new-password" />
            </div>
            <p class="bp-pf-error hidden" id="bpPwError"></p>
            <div class="bp-pf-actions">
              <button type="submit" class="btn btn-primary bp-pf-save">Update password</button>
            </div>
          </form>
        </div>

        <!-- OTP verification step (shown after profile save triggers verification) -->
        <div id="bpOtpStep" class="bp-otp-step hidden">
          <p class="bp-otp-hint" id="bpOtpHint"></p>
          <div class="bp-otp-row">
            <input type="text" id="bpOtpInput" class="bp-otp-input" inputmode="numeric"
                   maxlength="6" placeholder="000000" />
            <button class="btn btn-primary bp-otp-submit" id="bpOtpSubmit">Verify</button>
          </div>
          <p class="bp-pf-error hidden" id="bpOtpError"></p>
          <button class="bp-otp-resend" id="bpOtpResend">Resend code</button>
        </div>

        <p class="bp-prefs-saved hidden" id="bpProfileSaved">✓ Profile updated</p>
      </div>

      <!-- ── Notifications (merged) ── -->
      <div class="bp-section-card bp-prefs-card">
        <p class="bp-section-label" id="notifPanelTitle"><%= user.notificationChannel === 'whatsapp' ? 'WhatsApp' : 'Email' %> Notifications</p>
        <p class="bp-section-hint">Choose how and what Con Leche sends you. Changes save instantly.</p>

        <!-- Channel selector -->
        <form id="channelForm" class="bp-prefs-form" style="margin-bottom:0.5rem;">
          <div class="bp-channel-row">
            <label class="bp-channel-opt <%= (!user.notificationChannel || user.notificationChannel === 'email') ? 'active' : '' %>" id="chanEmail">
              <input type="radio" name="notificationChannel" value="email" <%= (!user.notificationChannel || user.notificationChannel === 'email') ? 'checked' : '' %> />
              <span class="bp-channel-icon">&#x2709;&#xFE0F;</span>
              <span class="bp-channel-name">Email</span>
            </label>
            <label class="bp-channel-opt <%= user.notificationChannel === 'whatsapp' ? 'active' : '' %>" id="chanWa">
              <input type="radio" name="notificationChannel" value="whatsapp" <%= user.notificationChannel === 'whatsapp' ? 'checked' : '' %> />
              <span class="bp-channel-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </span>
              <span class="bp-channel-name">WhatsApp</span>
            </label>
          </div>
          <p class="bp-section-hint" id="waPhoneHint" style="<%= (user.notificationChannel === 'whatsapp' && !user.phone) ? '' : 'display:none;' %>margin-top:0.4rem;color:rgba(88,18,23,0.75);">&#x26A0;&#xFE0F; Add your phone number in Profile above to receive WhatsApp messages.</p>
          <p class="bp-prefs-saved hidden" id="channelSaved">&#10003; Saved</p>
        </form>

        <div style="border-top:1px solid rgba(44,44,44,0.07);margin:0.1rem 0 0.85rem;"></div>

        <!-- What we send you -->
        <form id="prefsForm" class="bp-prefs-form">
          <label class="bp-pref-toggle">
            <div class="bp-pref-info">
              <span class="bp-pref-name">Events &amp; truck locations</span>
              <span class="bp-pref-desc">Where to find us &#8212; markets, pop-ups, run clubs</span>
            </div>
            <input type="checkbox" name="events" id="prefEvents" class="bp-toggle-input" <%= user.emailPreferences && user.emailPreferences.events ? 'checked' : '' %> />
            <span class="bp-toggle-track"><span class="bp-toggle-thumb"></span></span>
          </label>
          <label class="bp-pref-toggle">
            <div class="bp-pref-info">
              <span class="bp-pref-name">Birthday treat</span>
              <span class="bp-pref-desc">Free cookie + 10% off on your birthday</span>
            </div>
            <input type="checkbox" name="birthday" id="prefBirthday" class="bp-toggle-input" <%= user.emailPreferences && user.emailPreferences.birthday ? 'checked' : '' %> />
            <span class="bp-toggle-track"><span class="bp-toggle-thumb"></span></span>
          </label>
          <p class="bp-prefs-saved hidden" id="prefsSaved">&#10003; Saved</p>
        </form>

        <form id="mktConsentForm" class="bp-prefs-form" style="border-top:1px solid rgba(44,44,44,0.06);padding-top:0.5rem;margin-top:0.25rem;">
          <label class="bp-pref-toggle">
            <div class="bp-pref-info">
              <span class="bp-pref-name">Specials &amp; promotions</span>
              <span class="bp-pref-desc">New drinks, limited offers, seasonal features</span>
            </div>
            <input type="checkbox" name="marketingConsent" id="prefMktConsent" class="bp-toggle-input"
                   <%= user.marketingConsent ? 'checked' : '' %> />
            <span class="bp-toggle-track"><span class="bp-toggle-thumb"></span></span>
          </label>
          <div id="mktChannelPickerBp" style="<%= user.marketingConsent ? '' : 'display:none;' %>margin-top:0.6rem;">
            <p style="font-size:0.78rem;color:rgba(44,44,44,0.5);font-weight:600;margin-bottom:0.4rem;">Preferred channel for promotions</p>
            <div class="bp-channel-row" style="margin-bottom:0;">
              <label class="bp-channel-opt <%= (!user.marketingChannel || user.marketingChannel === 'email') ? 'active' : '' %>" id="mktChanEmail">
                <input type="radio" name="marketingChannel" value="email"
                       <%= (!user.marketingChannel || user.marketingChannel === 'email') ? 'checked' : '' %> />
                <span class="bp-channel-icon">&#x2709;&#xFE0F;</span>
                <span class="bp-channel-name">Email</span>
              </label>
              <label class="bp-channel-opt <%= user.marketingChannel === 'whatsapp' ? 'active' : '' %>" id="mktChanWa">
                <input type="radio" name="marketingChannel" value="whatsapp"
                       <%= user.marketingChannel === 'whatsapp' ? 'checked' : '' %> />
                <span class="bp-channel-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                </span>
                <span class="bp-channel-name">WhatsApp</span>
              </label>
            </div>
          </div>
          <p class="bp-prefs-saved hidden" id="mktConsentSaved">&#10003; Saved</p>
        </form>
      </div>

      <!-- ── Danger zone ── -->
      <div class="bp-danger-zone">
        <p class="bp-danger-label">Danger zone</p>
        <p class="bp-danger-sub">Permanently delete your Con Leche account. This removes your battlepass, all stamps, rewards, and order history. This cannot be undone.</p>
        <button class="btn bp-delete-btn" onclick="document.getElementById('deleteAccountOverlay').classList.add('open')">
          Delete my account
        </button>
      </div>

    </div>

    <!-- ════════════ TAB: REWARDS ════════════ -->
    <div class="bp-tab-panel hidden" id="tab-rewards">

      <!-- 9 LIVES -->
      <div class="bp-section-card">
        <p class="bp-section-label">9 Lives — every 10th drink is free 🐾</p>
        <% const livesUsed = user.totalDrinks % 10; %>
        <div class="lives-row">
          <% for (let i = 1; i <= 9; i++) { %>
          <div class="life-dot <%= i <= livesUsed ? 'life-used' : 'life-empty' %>">
            <span><%= i <= livesUsed ? '🐾' : '' %></span>
          </div>
          <% } %>
          <div class="life-dot life-free">
            <span>☕</span>
          </div>
        </div>
        <p class="lives-count"><%= livesUsed %> / 9 — <%= 10 - livesUsed %> drinks to go</p>
      </div>

      <!-- PROGRESS TO NEXT REWARD -->
      <% if (next) { %>
      <div class="bp-section-card">
        <p class="bp-section-label">Next Reward</p>
        <div class="bp-next-reward-row">
          <span class="bp-next-icon">
            <%= next.type === 'free_drink' ? '☕' : next.type === 'special' ? '✨' : next.type === 'merch' ? '🎁' : next.type === 'store_voucher' ? '💳' : '🎫' %>
          </span>
          <div class="bp-next-info">
            <p class="bp-next-desc"><%= next.description %></p>
            <p class="bp-next-count"><%= drinksToNext %> drink<%= drinksToNext !== 1 ? 's' : '' %> away</p>
          </div>
        </div>
        <% const pct = Math.min(100, Math.max(0, progressPct)); %>
        <div class="bp-prog-track">
          <div class="bp-prog-fill" data-pct="<%= pct %>"></div>
        </div>
      </div>
      <% } %>

      <!-- UPCOMING MILESTONES -->
      <% if (upcomingMilestones.length > 0) { %>
      <div class="bp-section-card">
        <p class="bp-section-label">Coming Up</p>
        <div class="bp-ms-list">
          <% upcomingMilestones.forEach((m, i) => { %>
          <div class="bp-ms-item <%= i === 0 ? 'bp-ms-next' : '' %>">
            <span class="bp-ms-icon">
              <%= m.type === 'free_drink' ? '☕' : m.type === 'special' ? '✨' : m.type === 'merch' ? '🎁' : m.type === 'store_voucher' ? '💳' : '🎫' %>
            </span>
            <div class="bp-ms-body">
              <p class="bp-ms-desc"><%= m.description %></p>
              <p class="bp-ms-num">Drink #<%= m.drinkNumber %><% if (m.expires) { %> · 7-day voucher<% } %></p>
            </div>
            <% if (i === 0) { %><span class="bp-ms-badge">Next</span><% } %>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- INVENTORY — banked rewards, kept until claimed -->
      <% if (claimableItems.length > 0) { %>
      <div class="bp-section-card">
        <p class="bp-section-label">🎁 Inventory — Ready to Claim</p>
        <p class="bp-section-hint">These never expire — claim whenever you like. Tap Claim and show the code to your barista.</p>
        <div class="bp-claim-list">
          <% claimableItems.forEach(reward => { %>
          <div class="bp-claim-item" data-reward-id="<%= reward._id %>">
            <div class="bp-claim-top">
              <span class="bp-claim-icon">
                <%= reward.type === 'free_drink' ? '☕' : reward.type === 'special' ? '✨' : reward.type === 'merch' ? '🎁' : '💳' %>
              </span>
              <div class="bp-claim-body">
                <p class="bp-claim-title"><%= reward.description %></p>
                <p class="bp-claim-earned">Earned at drink #<%= reward.drinkNumber %></p>
              </div>
            </div>
            <div class="bp-claim-action">
              <% const codeAge = reward.claimCodeGeneratedAt ? (new Date() - new Date(reward.claimCodeGeneratedAt)) / 1000 / 60 : 99; %>
              <% if (reward.claimCode && codeAge < 10) { %>
                <div class="bp-claim-show">
                  <% if (claimQrs && claimQrs[reward._id]) { %>
                  <div class="bp-claim-qr">
                    <img src="<%= claimQrs[reward._id] %>" alt="Reward QR" />
                    <span class="bp-claim-qr-hint">Barista scans this</span>
                  </div>
                  <% } %>
                  <div class="bp-code-display">
                    <span class="bp-code"><%= reward.claimCode %></span>
                    <span class="bp-code-hint">Read this to your barista</span>
                  </div>
                </div>
              <% } else { %>
                <button class="btn btn-primary claim-btn" data-id="<%= reward._id %>">Claim</button>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- ACTIVE VOUCHERS — 7 days, gone once redeemed -->
      <% if (activeVouchers.length > 0) { %>
      <div class="bp-section-card">
        <p class="bp-section-label">🎫 Active Vouchers</p>
        <p class="bp-section-hint">Valid 7 days from when you earned them. Tap Redeem at the counter — once redeemed, it's used up.</p>
        <div class="bp-voucher-list">
          <% activeVouchers.forEach(v => { %>
          <% const daysLeft = v.expiresAt ? Math.max(0, Math.ceil((new Date(v.expiresAt) - new Date()) / (1000*60*60*24))) : null; %>
          <div class="bp-voucher-item <%= daysLeft !== null && daysLeft <= 1 ? 'voucher-urgent' : '' %>" id="voucher-<%= v._id %>">
            <span class="bp-voucher-icon">🎫</span>
            <div class="bp-voucher-body">
              <p class="bp-voucher-desc"><%= v.description %></p>
              <p class="bp-voucher-sub">Earned at drink #<%= v.drinkNumber %></p>
            </div>
            <div class="bp-voucher-side">
              <% if (daysLeft !== null) { %>
              <div class="bp-days-left">
                <span class="bp-days-num"><%= daysLeft %></span>
                <span class="bp-days-lbl">day<%= daysLeft !== 1 ? 's' : '' %></span>
              </div>
              <% } %>
              <button class="btn btn-outline bp-redeem-btn" data-id="<%= v._id %>" data-desc="<%= v.description %>">Redeem</button>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <% if (claimableItems.length === 0 && activeVouchers.length === 0) { %>
      <div class="bp-section-card" style="text-align:center;">
        <p style="font-size:2rem;margin-bottom:0.5rem;">🐾</p>
        <p class="bp-section-label" style="margin-bottom:0.25rem;">Nothing to claim yet</p>
        <p class="bp-section-hint">Keep sipping — your next reward is on its way.</p>
      </div>
      <% } %>

    </div>

    <!-- ════════════ TAB: HISTORY ════════════ -->
    <div class="bp-tab-panel hidden" id="tab-history">

      <!-- STAMP HISTORY — when, by whom, how many -->
      <div class="bp-section-card">
        <p class="bp-section-label">☕ Stamp History</p>
        <% if (stampHistory && stampHistory.length > 0) { %>
        <div class="bp-voucher-list">
          <% stampHistory.forEach(log => { %>
          <div class="bp-voucher-item">
            <span class="bp-voucher-icon">☕</span>
            <div class="bp-voucher-body">
              <p class="bp-voucher-desc"><strong><%= log.quantity %></strong> drink<%= log.quantity !== 1 ? 's' : '' %> added<% if (log.totalAfter) { %> · total <%= log.totalAfter %><% } %></p>
              <p class="bp-voucher-sub">by <%= log.adminName || 'Staff' %> · <%= new Date(log.at).toLocaleString('en-ZA', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></p>
            </div>
          </div>
          <% }) %>
        </div>
        <% } else { %>
        <p class="bp-section-hint">Your stamps will show up here after your first scan.</p>
        <% } %>
      </div>

      <!-- REDEEMED REWARDS -->
      <% if (claimedItems.length > 0 || redeemedVouchers.length > 0) { %>
      <div class="bp-section-card">
        <p class="bp-section-label">✓ Redeemed Rewards</p>
        <div class="bp-voucher-list">
          <% claimedItems.forEach(r => { %>
          <div class="bp-voucher-item bp-item-faded">
            <span class="bp-voucher-icon">✓</span>
            <div class="bp-voucher-body">
              <p class="bp-voucher-desc"><%= r.description %></p>
              <p class="bp-voucher-sub">
                Claimed <%= (r.redeemedAt || r.claimedAt) ? new Date(r.redeemedAt || r.claimedAt).toLocaleDateString('en-ZA', { day:'numeric', month:'short', year:'numeric' }) : '' %><% if (r.claimedBy || r.redeemedBy) { %> · confirmed by <%= r.claimedBy || r.redeemedBy %><% } %>
              </p>
            </div>
          </div>
          <% }) %>
          <% redeemedVouchers.forEach(v => { %>
          <div class="bp-voucher-item bp-item-faded">
            <span class="bp-voucher-icon">🎫</span>
            <div class="bp-voucher-body">
              <p class="bp-voucher-desc"><%= v.description %></p>
              <p class="bp-voucher-sub">Redeemed <%= v.redeemedAt ? new Date(v.redeemedAt).toLocaleString('en-ZA', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) : '' %></p>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- PAST / EXPIRED -->
      <% if (expiredVouchers.length > 0) { %>
      <div class="bp-section-card bp-history-card">
        <p class="bp-section-label">⌛ Past Rewards</p>
        <div class="bp-voucher-list">
          <% expiredVouchers.forEach(v => { %>
          <div class="bp-voucher-item bp-item-faded">
            <span class="bp-voucher-icon">⌛</span>
            <div class="bp-voucher-body">
              <p class="bp-voucher-desc"><%= v.description %></p>
              <p class="bp-voucher-sub">Expired <%= new Date(v.expiresAt).toLocaleDateString('en-ZA') %></p>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- PURCHASE HISTORY -->
      <div class="bp-section-card" style="text-align:center;">
        <p class="bp-section-label">🛒 Purchase History</p>
        <p class="bp-section-hint" style="margin-bottom:0.85rem;">Your orders, live status and past slips live on the orders page.</p>
        <a href="/order/my-orders" class="btn btn-outline" style="border-color:rgba(88,18,23,0.35);color:var(--maroon);">View My Orders →</a>
      </div>

    </div>

  </div><!-- end bp-container -->
</section>
</main>

<!-- ── Live "barista is serving you" overlay ── -->
<div class="bp-live-overlay" id="bpLiveOverlay">
  <div class="bp-live-card">
    <div class="bp-live-spinner" id="bpLiveSpinner"></div>
    <div class="bp-live-check" id="bpLiveCheck">✓</div>
    <h2 class="bp-live-title" id="bpLiveTitle">Barista is loading your drinks…</h2>
    <p class="bp-live-sub" id="bpLiveSub">Hang tight, this only takes a moment.</p>
  </div>
</div>

<!-- Voucher redeem confirmation overlay -->
<div class="modal-overlay" id="redeemOverlay">
  <div class="modal-sheet" style="max-width:400px;border-radius:var(--radius-lg);">
    <button class="modal-close" onclick="closeRedeem()">✕</button>
    <div class="modal-body" style="padding-top:1.75rem;text-align:center;">
      <div style="font-size:2.5rem;margin-bottom:0.75rem;">🎫</div>
      <h2 style="font-family:var(--font-nimbus);font-size:1.3rem;margin-bottom:0.5rem;">Redeem this voucher?</h2>
      <p id="redeemDesc" style="color:rgba(44,44,44,0.7);margin-bottom:0.75rem;font-weight:600;"></p>
      <p style="color:rgba(44,44,44,0.5);font-size:0.82rem;margin-bottom:1.5rem;">Only tap Redeem <strong>at the counter with your barista watching</strong> — once redeemed it's used up and can't be brought back.</p>
      <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <button id="redeemConfirmBtn" class="btn btn-primary" style="min-width:150px;" onclick="confirmRedeem()">Redeem now</button>
        <button type="button" class="btn btn-outline" style="border-color:rgba(44,44,44,0.2);color:var(--charcoal);" onclick="closeRedeem()">Cancel</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete account confirmation overlay -->
<div class="modal-overlay" id="deleteAccountOverlay">
  <div class="modal-sheet" style="max-width:420px;border-radius:var(--radius-lg);">
    <button class="modal-close" onclick="document.getElementById('deleteAccountOverlay').classList.remove('open')">✕</button>
    <div class="modal-body" style="padding-top:1.75rem;text-align:center;">
      <div style="font-size:2.5rem;margin-bottom:0.75rem;">💔</div>
      <h2 style="font-family:var(--font-nimbus);font-size:1.4rem;margin-bottom:0.5rem;">We'll miss you</h2>
      <p style="color:rgba(44,44,44,0.6);margin-bottom:0.5rem;">Are you sure you want to delete your account?</p>
      <p style="color:rgba(44,44,44,0.5);font-size:0.82rem;margin-bottom:1rem;">You have <strong><%= user.totalDrinks %> stamps</strong> and <strong><%= claimableItems.length %> unclaimed rewards</strong>. All of this will be gone forever.</p>
      <p style="color:rgba(44,44,44,0.45);font-size:0.78rem;margin-bottom:1.5rem;">Type <strong>DELETE</strong> to confirm.</p>
      <input type="text" id="deleteConfirmInput" class="confirm-input"
             placeholder="Type DELETE here" style="text-align:center;margin-bottom:1rem;letter-spacing:0.1em;" />
      <div style="display:flex;gap:0.75rem;justify-content:center;flex-wrap:wrap;">
        <button id="confirmDeleteBtn" class="btn btn-primary" style="background:#c83232;min-width:160px;" disabled
                onclick="submitDelete()">Delete my account</button>
        <button type="button" class="btn btn-outline" style="border-color:rgba(44,44,44,0.2);color:var(--charcoal);"
                onclick="document.getElementById('deleteAccountOverlay').classList.remove('open')">Cancel</button>
      </div>
    </div>
  </div>
</div>

<script>
// ── Tabs ──────────────────────────────────────────────────────────
document.querySelectorAll('.bp-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.bp-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.bp-tab-panel').forEach(p => p.classList.add('hidden'));
    tab.classList.add('active');
    document.getElementById('tab-' + tab.dataset.tab).classList.remove('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
});

// ── Copy token ────────────────────────────────────────────────────
function copyToken() {
  const token = document.getElementById('bpToken').textContent.trim();
  navigator.clipboard.writeText(token).then(() => {
    const hint = document.getElementById('bpTokenCopy');
    hint.textContent = '✓ copied';
    setTimeout(() => { hint.textContent = 'tap to copy'; }, 2000);
  }).catch(() => {});
}

// ── Progress bar ──────────────────────────────────────────────────
document.querySelectorAll('.bp-prog-fill').forEach(el => {
  el.style.width = el.dataset.pct + '%';
});

// ── Claim buttons (free drinks / merch — 4-digit code flow) ───────
document.querySelectorAll('.claim-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id = btn.dataset.id;
    btn.textContent = '…';
    btn.disabled = true;
    try {
      const res = await fetch(`/battlepass/claim/${id}`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        const action = btn.closest('.bp-claim-action');
        action.innerHTML = `
          <div class="bp-claim-show">
            ${data.qrDataUrl ? `<div class="bp-claim-qr"><img src="${data.qrDataUrl}" alt="Reward QR" /><span class="bp-claim-qr-hint">Barista scans this</span></div>` : ''}
            <div class="bp-code-display">
              <span class="bp-code">${data.code}</span>
              <span class="bp-code-hint">Read this to your barista</span>
            </div>
          </div>`;
      } else {
        btn.textContent = 'Claim';
        btn.disabled = false;
        alert(data.message);
      }
    } catch (e) {
      btn.textContent = 'Claim';
      btn.disabled = false;
    }
  });
});

// ── Voucher redeem (confirm → mark used → big REDEEMED state) ─────
let redeemTargetId = null;
document.querySelectorAll('.bp-redeem-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    redeemTargetId = btn.dataset.id;
    document.getElementById('redeemDesc').textContent = btn.dataset.desc;
    document.getElementById('redeemOverlay').classList.add('open');
  });
});
function closeRedeem() {
  document.getElementById('redeemOverlay').classList.remove('open');
  redeemTargetId = null;
}
async function confirmRedeem() {
  if (!redeemTargetId) return;
  const id = redeemTargetId;
  const btn = document.getElementById('redeemConfirmBtn');
  btn.disabled = true; btn.textContent = 'Redeeming…';
  try {
    const res = await fetch(`/battlepass/redeem-voucher/${id}`, { method: 'POST' });
    const data = await res.json();
    btn.disabled = false; btn.textContent = 'Redeem now';
    if (data.success) {
      const item = document.getElementById('voucher-' + id);
      if (item) {
        const time = new Date(data.redeemedAt).toLocaleTimeString('en-ZA', { hour: '2-digit', minute: '2-digit' });
        item.innerHTML = `
          <div class="bp-redeemed-flash">
            <span class="bp-redeemed-check">✓</span>
            <div>
              <p class="bp-redeemed-title">REDEEMED</p>
              <p class="bp-redeemed-sub">${data.description} · ${time}</p>
            </div>
          </div>`;
        item.classList.add('bp-voucher-redeemed');
      }
      closeRedeem();
    } else {
      alert(data.message);
      closeRedeem();
    }
  } catch (e) {
    btn.disabled = false; btn.textContent = 'Redeem now';
  }
}
document.getElementById('redeemOverlay').addEventListener('click', function(e) {
  if (e.target === this) closeRedeem();
});

// ── Edit Profile ──────────────────────────────────────────────────
(function () {
  var editBtn    = document.getElementById('bpProfileEditBtn');
  var display    = document.getElementById('bpProfileDisplay');
  var form       = document.getElementById('bpProfileForm');
  var actionsDiv = document.getElementById('bpPfActions');
  var otpStep    = document.getElementById('bpOtpStep');
  var otpInput   = document.getElementById('bpOtpInput');
  var otpSubmit  = document.getElementById('bpOtpSubmit');
  var otpResend  = document.getElementById('bpOtpResend');
  var otpHint    = document.getElementById('bpOtpHint');
  var otpErr     = document.getElementById('bpOtpError');
  var pfErr      = document.getElementById('bpPfError');
  var saved      = document.getElementById('bpProfileSaved');
  var pfName     = document.getElementById('pfName');
  var pfEmail    = document.getElementById('pfEmail');
  var pfPhone    = document.getElementById('pfPhone');
  var origValues = {};

  var pwSection  = document.getElementById('bpPasswordSection');
  var pwToggle   = document.getElementById('bpPwToggle');
  var pwForm     = document.getElementById('bpPasswordForm');
  var pwErr      = document.getElementById('bpPwError');
  var pfOld      = document.getElementById('pfOldPassword');
  var pfNew      = document.getElementById('pfNewPassword');
  var pfConfirm  = document.getElementById('pfConfirmNewPassword');
  var otpSource  = 'profile'; // 'profile' | 'password' — which form triggered the OTP step

  function resetPasswordForm() {
    pwForm.classList.add('hidden');
    pwForm.reset();
    pwErr.classList.add('hidden');
  }

  function showDisplay() {
    display.classList.remove('hidden');
    form.classList.add('hidden');
    otpStep.classList.add('hidden');
    pwSection.classList.add('hidden');
    resetPasswordForm();
    actionsDiv.style.display = 'none';
    editBtn.textContent = 'Edit profile ✎';
    editBtn.removeAttribute('data-mode');
  }

  function showEdit() {
    origValues = { name: pfName.value, email: pfEmail.value, phone: pfPhone.value };
    display.classList.add('hidden');
    form.classList.remove('hidden');
    otpStep.classList.add('hidden');
    pwSection.classList.remove('hidden');
    resetPasswordForm();
    pfErr.classList.add('hidden');
    actionsDiv.style.display = 'none';
    editBtn.textContent = 'Cancel';
    editBtn.dataset.mode = 'cancel';
  }

  function checkChanges() {
    var changed = pfName.value !== origValues.name
               || pfEmail.value !== origValues.email
               || pfPhone.value !== origValues.phone;
    actionsDiv.style.display = changed ? 'flex' : 'none';
  }

  editBtn.addEventListener('click', function () {
    if (editBtn.dataset.mode === 'cancel') {
      pfName.value  = origValues.name  || '';
      pfEmail.value = origValues.email || '';
      pfPhone.value = origValues.phone || '';
      showDisplay();
    } else {
      showEdit();
    }
  });

  pfName.addEventListener('input', checkChanges);
  pfEmail.addEventListener('input', checkChanges);
  pfPhone.addEventListener('input', checkChanges);

  pwToggle.addEventListener('click', function () {
    pwForm.classList.toggle('hidden');
    if (!pwForm.classList.contains('hidden')) pfOld.focus();
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    pfErr.classList.add('hidden');
    var btn = form.querySelector('.bp-pf-save');
    btn.disabled = true; btn.textContent = 'Saving…';
    var body = new URLSearchParams(new FormData(form));
    fetch('/battlepass/update-profile', { method: 'POST', body: body })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        btn.disabled = false; btn.textContent = 'Save changes';
        if (!json.success) {
          pfErr.textContent = json.message || 'Something went wrong.';
          pfErr.classList.remove('hidden'); return;
        }
        if (pfName.value.trim()) {
          document.getElementById('bpNameDisplay').textContent = pfName.value.trim();
        }
        if (!json.verified) {
          showDisplay();
          var dispVals = display.querySelectorAll('.bp-profile-val');
          if (dispVals[0]) dispVals[0].textContent = pfName.value;
          saved.classList.remove('hidden');
          setTimeout(function () { saved.classList.add('hidden'); }, 2500);
        } else {
          otpSource = 'profile';
          form.classList.add('hidden');
          pwSection.classList.add('hidden');
          otpStep.classList.remove('hidden');
          otpHint.textContent = json.hint || 'Enter the code we sent you.';
          otpInput.value = '';
          otpInput.focus();
        }
      });
  });

  pwForm.addEventListener('submit', function (e) {
    e.preventDefault();
    pwErr.classList.add('hidden');
    var btn = pwForm.querySelector('.bp-pf-save');
    btn.disabled = true; btn.textContent = 'Sending code…';
    var body = new URLSearchParams(new FormData(pwForm));
    fetch('/battlepass/change-password', { method: 'POST', body: body })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        btn.disabled = false; btn.textContent = 'Update password';
        if (!json.success) {
          pwErr.textContent = json.message || 'Something went wrong.';
          pwErr.classList.remove('hidden'); return;
        }
        otpSource = 'password';
        form.classList.add('hidden');
        pwSection.classList.add('hidden');
        otpStep.classList.remove('hidden');
        otpHint.textContent = json.hint || 'Enter the code we sent you.';
        otpInput.value = '';
        otpInput.focus();
      });
  });

  function submitOtp() {
    otpErr.classList.add('hidden');
    otpSubmit.disabled = true; otpSubmit.textContent = 'Verifying…';
    var body = new URLSearchParams({ code: otpInput.value });
    fetch('/battlepass/verify-profile', { method: 'POST', body: body })
      .then(function (res) { return res.json(); })
      .then(function (json) {
        otpSubmit.disabled = false; otpSubmit.textContent = 'Verify';
        if (!json.success) {
          otpErr.textContent = json.message || 'Incorrect code.';
          otpErr.classList.remove('hidden'); return;
        }
        if (otpSource === 'password') {
          resetPasswordForm();
        } else {
          var dispVals = display.querySelectorAll('.bp-profile-val');
          if (pfEmail.value && dispVals[1]) dispVals[1].textContent = pfEmail.value;
          if (pfPhone.value && dispVals[2]) dispVals[2].textContent = pfPhone.value;
        }
        showDisplay();
        saved.textContent = otpSource === 'password' ? '✓ Password updated' : '✓ Profile updated';
        saved.classList.remove('hidden');
        setTimeout(function () {
          saved.classList.add('hidden');
          saved.textContent = '✓ Profile updated';
        }, 2500);
      });
  }

  otpSubmit.addEventListener('click', submitOtp);
  otpInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); submitOtp(); }
  });
  otpInput.addEventListener('input', function () {
    otpInput.value = otpInput.value.replace(/\D/g, '').slice(0, 6);
    if (otpInput.value.length === 6) submitOtp();
  });
  otpResend.addEventListener('click', function () {
    otpResend.disabled = true; otpResend.textContent = 'Sending…';
    fetch('/battlepass/resend-profile-otp', { method: 'POST' })
      .then(function () {
        otpResend.textContent = 'Sent!';
        setTimeout(function () { otpResend.disabled = false; otpResend.textContent = 'Resend code'; }, 3000);
      });
  });
})();

// ── Notification channel (email vs WhatsApp) ──────────────────────
(function () {
  var form     = document.getElementById('channelForm');
  var titleEl  = document.getElementById('notifPanelTitle');
  var waHint   = document.getElementById('waPhoneHint');
  var hasPhone = <%= user.phone ? 'true' : 'false' %>;
  if (!form) return;

  function updateTitle(channel) {
    if (titleEl) titleEl.textContent = (channel === 'whatsapp' ? 'WhatsApp' : 'Email') + ' Notifications';
  }

  form.querySelectorAll('input[name="notificationChannel"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      var isWa = radio.value === 'whatsapp';
      form.querySelectorAll('.bp-channel-opt').forEach(function (l) { l.classList.remove('active'); });
      radio.closest('.bp-channel-opt').classList.add('active');
      updateTitle(radio.value);
      if (waHint) waHint.style.display = (isWa && !hasPhone) ? '' : 'none';
    });
  });

  var saveTimer = null;
  function save() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(function () {
      var data = new FormData(form);
      var body = new URLSearchParams(data);
      fetch('/battlepass/preferences', { method: 'POST', body: body })
        .then(function (r) { return r.json(); })
        .then(function (json) {
          if (json.success) {
            var saved = document.getElementById('channelSaved');
            saved.classList.remove('hidden');
            setTimeout(function () { saved.classList.add('hidden'); }, 2500);
          }
        });
    }, 600);
  }

  form.querySelectorAll('input[name="notificationChannel"]').forEach(function (r) {
    r.addEventListener('change', save);
  });
})();

// ── Email preferences toggles ─────────────────────────────────────
(function () {
  var form = document.getElementById('prefsForm');
  if (!form) return;
  var saveTimer = null;
  form.querySelectorAll('.bp-toggle-input').forEach(function (input) {
    input.addEventListener('change', function () {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(function () {
        var data = new FormData(form);
        ['events','birthday'].forEach(function (k) { if (!data.has(k)) data.append(k, 'off'); });
        var body = new URLSearchParams(data);
        fetch('/battlepass/preferences', { method: 'POST', body: body })
          .then(function (r) { return r.json(); })
          .then(function (json) {
            if (json.success) {
              var saved = document.getElementById('prefsSaved');
              saved.classList.remove('hidden');
              setTimeout(function () { saved.classList.add('hidden'); }, 2500);
            }
          });
      }, 400);
    });
  });
})();

// ── Marketing consent ─────────────────────────────────────────────
(function () {
  var form         = document.getElementById('mktConsentForm');
  var consentChk   = document.getElementById('prefMktConsent');
  var channelPicker = document.getElementById('mktChannelPickerBp');
  if (!form) return;

  function togglePicker() {
    channelPicker.style.display = consentChk.checked ? '' : 'none';
    document.querySelectorAll('#mktChannelPickerBp .bp-channel-opt').forEach(function (l) {
      l.classList.remove('active');
    });
    var checked = form.querySelector('input[name="marketingChannel"]:checked');
    if (checked) checked.closest('.bp-channel-opt').classList.add('active');
  }

  consentChk.addEventListener('change', function () { togglePicker(); save(); });

  form.querySelectorAll('input[name="marketingChannel"]').forEach(function (r) {
    r.addEventListener('change', function () {
      document.querySelectorAll('#mktChannelPickerBp .bp-channel-opt').forEach(function (l) {
        l.classList.remove('active');
      });
      r.closest('.bp-channel-opt').classList.add('active');
      save();
    });
  });

  var saveTimer = null;
  function save() {
    clearTimeout(saveTimer);
    saveTimer = setTimeout(function () {
      var data = new FormData(form);
      if (!data.has('marketingConsent')) data.append('marketingConsent', 'off');
      var body = new URLSearchParams(data);
      fetch('/battlepass/marketing-consent', { method: 'POST', body: body })
        .then(function (r) { return r.json(); })
        .then(function (json) {
          if (json.success) {
            var saved = document.getElementById('mktConsentSaved');
            saved.classList.remove('hidden');
            setTimeout(function () { saved.classList.add('hidden'); }, 2500);
          }
        });
    }, 400);
  }
})();

// ── Delete account ────────────────────────────────────────────────
const deleteInput = document.getElementById('deleteConfirmInput');
const confirmBtn  = document.getElementById('confirmDeleteBtn');
if (deleteInput) {
  deleteInput.addEventListener('input', () => {
    confirmBtn.disabled = deleteInput.value.trim().toUpperCase() !== 'DELETE';
  });
}
function submitDelete() {
  if (deleteInput.value.trim().toUpperCase() !== 'DELETE') return;
  confirmBtn.disabled = true;
  confirmBtn.textContent = 'Deleting…';
  fetch('/account/delete', { method: 'POST' })
    .then(r => r.json())
    .then(d => { if (d.ok) window.location = '/'; })
    .catch(() => { confirmBtn.disabled = false; confirmBtn.textContent = 'Delete my account'; });
}
document.getElementById('deleteAccountOverlay').addEventListener('click', function(e) {
  if (e.target === this) this.classList.remove('open');
});

// ── Live stamp updates ────────────────────────────────────────────
// Poll the server. While a barista is mid-scan, show "Barista is loading
// your drinks…" with a spinner; when the drink count goes up, swap to a
// check mark, then refresh the page so stamps/rewards/history are current.
(function () {
  const overlay = document.getElementById('bpLiveOverlay');
  const spinner = document.getElementById('bpLiveSpinner');
  const check   = document.getElementById('bpLiveCheck');
  const title   = document.getElementById('bpLiveTitle');
  const sub     = document.getElementById('bpLiveSub');
  let knownTotal = <%= Number(user.totalDrinks) || 0 %>;
  let celebrating = false;

  function showLoading() {
    spinner.style.display = 'block';
    check.style.display   = 'none';
    title.textContent = 'Barista is loading your drinks…';
    sub.textContent   = 'Hang tight, this only takes a moment.';
    overlay.classList.add('open');
  }
  function showAdded(added, newTotal) {
    celebrating = true;
    spinner.style.display = 'none';
    check.style.display   = 'flex';
    title.textContent = added + (added === 1 ? ' drink added!' : ' drinks added!');
    sub.textContent   = 'You now have ' + newTotal + ' drinks. Refreshing…';
    overlay.classList.add('open');
    setTimeout(() => window.location.reload(), 2200);
  }

  async function poll() {
    if (celebrating) return;
    try {
      const res = await fetch('/battlepass/status', { headers: { 'Accept': 'application/json' } });
      if (!res.ok) return;
      const d = await res.json();
      if (!d.ok) return;
      if (d.totalDrinks > knownTotal) {
        const added = d.totalDrinks - knownTotal;
        knownTotal = d.totalDrinks;
        showAdded(added, d.totalDrinks);
      } else if (d.pending) {
        showLoading();
      } else {
        overlay.classList.remove('open');
      }
    } catch (_) { /* offline / transient — try again next tick */ }
  }

  setInterval(poll, 2500);
  poll();
})();
</script>

<script>
// ── Edit name ────────────────────────────────────────────────────
const bpNameDisplay = document.getElementById('bpNameDisplay');
const bpEditBtn     = document.getElementById('bpEditNameBtn');
const bpNameForm    = document.getElementById('bpNameForm');
const bpNameInput   = document.getElementById('bpNameInput');
const bpNameCancel  = document.getElementById('bpNameCancel');

if (bpEditBtn) {
  bpEditBtn.addEventListener('click', () => {
    bpNameForm.classList.remove('hidden');
    bpEditBtn.classList.add('hidden');
    bpNameInput.focus();
  });
  bpNameCancel.addEventListener('click', () => {
    bpNameForm.classList.add('hidden');
    bpEditBtn.classList.remove('hidden');
  });
  bpNameInput.addEventListener('input', function () {
    const pos = this.selectionStart;
    this.value = this.value.replace(/[^A-Za-z\s]/g, '').replace(/\b\w/g, c => c.toUpperCase());
    this.setSelectionRange(pos, pos);
  });
  bpNameForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const newName = bpNameInput.value.trim();
    if (!newName) return;
    try {
      const r = await fetch('/battlepass/update-name', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: newName })
      });
      const d = await r.json();
      if (d.ok) {
        bpNameDisplay.textContent = d.name;
        bpNameForm.classList.add('hidden');
        bpEditBtn.classList.remove('hidden');
      }
    } catch(err) {}
  });
}
</script>

