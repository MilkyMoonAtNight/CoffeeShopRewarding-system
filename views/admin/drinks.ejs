<%- include('./layout-top') %>

<div class="admin-page-header">
  <h1 class="admin-page-title">Drinks Menu</h1>
  <p class="admin-page-sub">Add, edit, delete or toggle availability of drinks</p>
</div>

<% if (msg) { %><div class="admin-alert <%= msg.startsWith('Error') ? 'admin-alert-error' : 'admin-alert-success' %>"><%= msg %></div><% } %>

<div class="admin-two-col">

  <!-- Add drink -->
  <div class="admin-card">
    <h3 class="admin-card-title">Add New Drink</h3>
    <form action="/admin/drinks/add" method="POST" enctype="multipart/form-data" class="auth-form">
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" required placeholder="e.g. Oat Latte" />
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="category" class="scan-input">
          <option value="hot">☕ Hot</option>
          <option value="cold">🧊 Cold</option>
        </select>
      </div>
      <div class="form-group">
        <label>Subcategory</label>
        <select name="subcategory" class="scan-input">
          <option value="espresso">Espresso</option>
          <option value="specialty">Specialty</option>
          <option value="chocolate">Chocolate</option>
          <option value="tea">Tea / Matcha</option>
          <option value="freezo">Freezo</option>
          <option value="iced">Iced</option>
          <option value="frozen">Frozen</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
        <div class="form-group">
          <label>Sml Price (R)</label>
          <input type="number" name="priceRegular" placeholder="e.g. 35" min="0" />
        </div>
        <div class="form-group">
          <label>Lrg Price (R)</label>
          <input type="number" name="priceLarge" placeholder="e.g. 45" min="0" />
        </div>
        <div class="form-group">
          <label>Grande Price (R)</label>
          <input type="number" name="priceGrande" placeholder="soon" min="0" />
        </div>
        <div class="form-group"></div>
        <div class="form-group">
          <label>Sml Size</label>
          <input type="text" name="sizeRegular" placeholder="e.g. 250ml" />
        </div>
        <div class="form-group">
          <label>Lrg Size</label>
          <input type="text" name="sizeLarge" placeholder="e.g. 350ml" />
        </div>
        <div class="form-group">
          <label>Grande Size</label>
          <input type="text" name="sizeGrande" placeholder="e.g. 450ml" />
        </div>
      </div>
      <div class="form-group">
        <label>Short description</label>
        <input type="text" name="description" placeholder="e.g. Espresso with steamed oat milk and a hint of vanilla" maxlength="160" />
      </div>
      <div class="form-group">
        <label>Flavours (comma separated)</label>
        <input type="text" name="flavours" placeholder="Vanilla, Caramel, Hazelnut…" />
      </div>

      <!-- Image upload -->
      <div class="form-group">
        <label>Photo</label>
        <div class="upload-zone" id="drinkUploadZone" onclick="document.getElementById('drinkImageFile').click()">
          <div class="upload-zone-inner" id="drinkUploadInner">
            <span class="upload-icon">📷</span>
            <span class="upload-label">Tap to upload photo</span>
            <span class="upload-hint">JPG, PNG, WebP or SVG · max 10MB</span>
          </div>
        </div>
        <input type="file" id="drinkImageFile" name="imageFile" accept="image/*,.svg" style="display:none;" onchange="previewUpload(this,'drinkUploadInner','drinkUploadZone')" />
        <span class="form-hint">Or enter a filename if already uploaded:</span>
        <input type="text" name="image" placeholder="e.g. flat-white.jpg" style="margin-top:0.35rem;" />
      </div>

      <div class="form-group" style="flex-direction:row;align-items:center;gap:0.5rem;">
        <input type="hidden" name="order" value="99" />
        <input type="checkbox" name="isSpecial" id="isSpecial" style="width:auto;" />
        <label for="isSpecial" style="margin:0;font-size:0.85rem;">Mark as Special</label>
      </div>
      <button type="submit" class="btn btn-primary btn-full">Add Drink</button>
    </form>
  </div>

  <!-- Drink list -->
  <div>
    <div class="admin-card admin-filter-bar">
      <input type="text" id="drinkSearch" class="scan-input" placeholder="🔍 Search drinks…" oninput="filterAdminList()" />
      <select id="drinkCatFilter" class="scan-input" onchange="filterAdminList()">
        <option value="">All categories</option>
        <option value="hot">☕ Hot</option>
        <option value="cold">🧊 Cold</option>
        <option value="espresso">Espresso</option>
        <option value="specialty">Specialty</option>
        <option value="chocolate">Chocolate</option>
        <option value="tea">Tea</option>
        <option value="iced">Iced</option>
        <option value="freezo">Freezo</option>
        <option value="frozen">Frozen</option>
      </select>
    </div>
    <% ['hot','cold'].forEach(cat => { %>
    <h3 class="drinks-cat-heading <%= cat==='cold'?'drinks-cat-cold':'' %>">
      <%= cat==='hot' ? '☕ Hot Drinks' : '🧊 Cold Drinks' %>
    </h3>
    <% drinks.filter(d => d.category === cat).forEach(drink => { %>
    <div class="admin-card admin-drink-row filterable-row <%= !drink.available ? 'drink-unavailable' : '' %>" style="margin-bottom:0.75rem;" data-name="<%= (drink.name || '').toLowerCase() %>" data-cat="<%= drink.category %> <%= drink.subcategory || '' %>">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;">
        <div style="display:flex;align-items:center;gap:0.75rem;flex:1;min-width:0;">
          <% if (drink.image) { %>
          <img src="<%= drink.image.startsWith('/') ? drink.image : '/images/drinks/' + drink.image %>" alt="<%= drink.name %>"
               style="width:44px;height:44px;object-fit:cover;border-radius:8px;flex-shrink:0;" />
          <% } else { %>
          <div style="width:44px;height:44px;border-radius:8px;background:var(--cream-dark);display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;">☕</div>
          <% } %>
          <div>
            <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
              <strong style="font-size:0.92rem;"><%= drink.name %></strong>
              <% if (!drink.available) { %><span class="admin-item-tag tag-off">Off</span><% } %>
              <% if (drink.isSpecial) { %><span class="admin-item-tag tag-special">Special</span><% } %>
            </div>
            <p style="font-size:0.75rem;color:rgba(44,44,44,0.45);margin-top:0.1rem;">
              <% if (drink.prices.regular) { %>R<%= drink.prices.regular %> reg<% } %>
              <% if (drink.prices.regular && drink.prices.large) { %> · <% } %>
              <% if (drink.prices.large) { %>R<%= drink.prices.large %> lge<% } %>
            </p>
          </div>
        </div>
        <div style="display:flex;gap:0.4rem;flex-shrink:0;">
          <form action="/admin/drinks/toggle/<%= drink._id %>" method="POST" style="display:inline;">
            <button type="submit" class="admin-toggle-btn"><%= drink.available ? 'Hide' : 'Show' %></button>
          </form>
          <button type="button" onclick="openDrinkEdit('<%= drink._id %>')" class="admin-toggle-btn">Edit</button>
          <form action="/admin/drinks/delete/<%= drink._id %>" method="POST" onsubmit="return confirm('Delete <%= drink.name %>?')" style="display:inline;">
            <button type="submit" class="admin-toggle-btn" style="color:#c83232;border-color:#c83232;">Del</button>
          </form>
        </div>
      </div>

      <!-- Inline edit panel -->
      <div id="dedit-<%= drink._id %>" style="display:none;margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(44,44,44,0.08);">
        <form action="/admin/drinks/edit/<%= drink._id %>" method="POST" enctype="multipart/form-data">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
            <div class="form-group" style="grid-column:span 2;">
              <label>Name</label>
              <input type="text" name="name" value="<%= drink.name %>" required class="scan-input" />
            </div>
            <div class="form-group">
              <label>Sml Price (R)</label>
              <input type="number" name="priceRegular" value="<%= drink.prices.regular || '' %>" class="scan-input" />
            </div>
            <div class="form-group">
              <label>Lrg Price (R)</label>
              <input type="number" name="priceLarge" value="<%= drink.prices.large || '' %>" class="scan-input" />
            </div>
            <div class="form-group">
              <label>Grande Price (R)</label>
              <input type="number" name="priceGrande" value="<%= drink.prices.grande || '' %>" class="scan-input" placeholder="soon" />
            </div>
            <div class="form-group">
              <label>Sml Size</label>
              <input type="text" name="sizeRegular" value="<%= drink.sizeLabels?.regular || '' %>" class="scan-input" />
            </div>
            <div class="form-group">
              <label>Lrg Size</label>
              <input type="text" name="sizeLarge" value="<%= drink.sizeLabels?.large || '' %>" class="scan-input" />
            </div>
            <div class="form-group">
              <label>Grande Size</label>
              <input type="text" name="sizeGrande" value="<%= drink.sizeLabels?.grande || '' %>" class="scan-input" placeholder="e.g. 450ml" />
            </div>
            <div class="form-group" style="grid-column:span 2;">
              <label>Short description</label>
              <input type="text" name="description" value="<%= drink.description || '' %>" class="scan-input" maxlength="160" />
            </div>
            <div class="form-group" style="grid-column:span 2;">
              <label>Flavours (comma separated)</label>
              <input type="text" name="flavours" value="<%= (drink.flavours||[]).join(', ') %>" class="scan-input" />
            </div>
            <div class="form-group" style="grid-column:span 2;">
              <label>Replace photo</label>
              <div class="upload-zone upload-zone-sm" id="ez-<%= drink._id %>" onclick="document.getElementById('ef-<%= drink._id %>').click()">
                <div class="upload-zone-inner" id="ei-<%= drink._id %>">
                  <span class="upload-icon" style="font-size:1.2rem;">📷</span>
                  <span class="upload-label" style="font-size:0.78rem;">Tap to choose new photo</span>
                </div>
              </div>
              <input type="file" id="ef-<%= drink._id %>" name="imageFile" accept="image/*,.svg" style="display:none;"
                     onchange="previewUpload(this,'ei-<%= drink._id %>','ez-<%= drink._id %>')" />
            </div>
            <div class="form-group">
              <input type="hidden" name="order" value="<%= drink.order %>" />
              <label>Available</label>
              <select name="available" class="scan-input">
                <option value="true" <%= drink.available?'selected':'' %>>Yes</option>
                <option value="false" <%= !drink.available?'selected':'' %>>No</option>
              </select>
            </div>
            <input type="hidden" name="category" value="<%= drink.category %>" />
            <input type="hidden" name="subcategory" value="<%= drink.subcategory %>" />
            <input type="hidden" name="isSpecial" value="<%= drink.isSpecial %>" />
          </div>

          <!-- Drink panel layer editor -->
          <div class="layer-editor" data-drink="<%= drink._id %>">
            <p class="detail-section-label" style="margin-top:0.75rem;">Drink panel layers</p>
            <p class="form-hint">Drag a texture into the stack. The top row is the top of the cup.</p>
            <div class="layer-editor-cols">
              <div class="layer-col">
                <span class="layer-col-title">Available textures</span>
                <div class="layer-avail" id="avail-<%= drink._id %>"></div>
              </div>
              <div class="layer-col">
                <span class="layer-col-title">Current drink</span>
                <div class="layer-stack" id="layers-<%= drink._id %>"></div>
              </div>
            </div>
            <div class="layer-preview-row">
              <div>
                <span class="layer-col-title">Size</span>
                <div class="layer-size-toggle" id="size-<%= drink._id %>"></div>
              </div>
              <div>
                <span class="layer-col-title">Live preview</span>
                <div class="layer-preview" id="preview-<%= drink._id %>"></div>
              </div>
            </div>
            <input type="hidden" name="layers" id="layersInput-<%= drink._id %>" value="<%= JSON.stringify(drink.layers || []) %>" />
          </div>

          <button type="submit" class="btn btn-primary" style="margin-top:0.5rem;width:100%;">Save Changes</button>
        </form>
      </div>
    </div>
    <% }) %>
    <% }) %>
  </div>
</div>

<script>

function filterAdminList() {
  const q   = (document.getElementById('drinkSearch')?.value || document.getElementById('pastrySearch')?.value || document.getElementById('eventSearch')?.value || '').toLowerCase().trim();
  const cat = (document.getElementById('drinkCatFilter')?.value || document.getElementById('pastryCatFilter')?.value || document.getElementById('eventTypeFilter')?.value || '');
  document.querySelectorAll('.filterable-row').forEach(row => {
    const matchQ   = !q   || (row.dataset.name || '').includes(q);
    const matchCat = !cat || (row.dataset.cat || '').split(' ').includes(cat);
    row.style.display = (matchQ && matchCat) ? '' : 'none';
  });
  // Hide category headings whose rows are all hidden
  document.querySelectorAll('.drinks-cat-heading, .admin-cat-heading').forEach(h => {
    let el = h.nextElementSibling, any = false;
    while (el && !el.classList.contains('drinks-cat-heading') && !el.classList.contains('admin-cat-heading')) {
      if (el.classList.contains('filterable-row') && el.style.display !== 'none') { any = true; break; }
      el = el.nextElementSibling;
    }
    h.style.display = any ? '' : 'none';
  });
}

function toggleEdit(id) {
  const el = document.getElementById(id);
  el.style.display = el.style.display === 'none' ? 'block' : 'none';
}
function previewUpload(input, innerId, zoneId) {
  if (!input.files || !input.files[0]) return;
  const file = input.files[0];
  const reader = new FileReader();
  reader.onload = e => {
    const inner = document.getElementById(innerId);
    const zone  = document.getElementById(zoneId);
    inner.innerHTML = `<img src="${e.target.result}" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />`;
    zone.style.border = '2px solid var(--maroon)';
  };
  reader.readAsDataURL(file);
}
</script>

<!-- ── Drink panel layer editor ── -->
<script>
window.ADMIN_TEXTURES = <%- JSON.stringify(textures.map(t => ({ slug:t.slug, name:t.name, baseColor:t.baseColor, dots:t.dots, dotColor:t.dotColor, dotDensity:t.dotDensity }))).replace(/</g,"\\u003c") %>;
window.ADMIN_DRINK_LAYERS = <%- JSON.stringify(drinks.reduce((acc, d) => {
  acc[d._id] = {
    layers: (d.layers || []).map(l => ({ textureSlug: l.textureSlug, pct: l.pct })),
    sizes: {
      regular: (d.sizeLabels && d.sizeLabels.regular) ? { label: 'Regular', ml: d.sizeLabels.regular } : null,
      large:   (d.sizeLabels && d.sizeLabels.large)   ? { label: 'Large',   ml: d.sizeLabels.large   } : null
    }
  };
  return acc;
}, {})).replace(/</g,"\\u003c") %>;
</script>
<script src="/js/drink-panel.js"></script>
<script>
(function () {
  var TEX = window.ADMIN_TEXTURES || [];
  var TEXMAP = {};
  TEX.forEach(function (t) { TEXMAP[t.slug] = { baseColor: t.baseColor, dots: t.dots, dotColor: t.dotColor, dotDensity: t.dotDensity, name: t.name }; });
  var DRINKS = window.ADMIN_DRINK_LAYERS || {};
  var initted = {};

  window.openDrinkEdit = function (id) {
    var panel = document.getElementById('dedit-' + id);
    if (panel) panel.style.display = (panel.style.display === 'none' || !panel.style.display) ? 'block' : 'none';
    if (panel && panel.style.display === 'block' && !initted[id]) { initEditor(id); initted[id] = true; }
  };

  function initEditor(id) {
    var info  = DRINKS[id] || { layers: [], sizes: {} };
    var state = { layers: (info.layers || []).map(function (l) { return { textureSlug: l.textureSlug, pct: Number(l.pct) || 0 }; }) };
    var sizes = info.sizes || {};
    var sizeKeys = ['regular', 'large'].filter(function (k) { return sizes[k]; });
    var selSize = sizeKeys[0] || null;

    var availEl = document.getElementById('avail-' + id);
    var stackEl = document.getElementById('layers-' + id);
    var sizeEl  = document.getElementById('size-' + id);
    var prevEl  = document.getElementById('preview-' + id);
    var hidden  = document.getElementById('layersInput-' + id);
    if (!availEl || !stackEl || !hidden) return;

    // Available palette
    availEl.innerHTML = TEX.length ? TEX.map(function (t) {
      return '<div class="layer-chip" draggable="true" data-slug="' + t.slug + '">'
        + '<span class="layer-swatch" style="background:' + t.baseColor + ';' + (t.dots ? 'outline:1px dashed #999;outline-offset:-3px;' : '') + '"></span>'
        + '<span>' + t.name + '</span></div>';
    }).join('') : '<span class="form-hint">No textures yet — add some under Textures.</span>';
    availEl.querySelectorAll('.layer-chip').forEach(function (chip) {
      chip.addEventListener('dragstart', function (e) { e.dataTransfer.setData('text/plain', 'add:' + chip.dataset.slug); });
    });

    // Size toggle
    sizeEl.innerHTML = sizeKeys.length ? sizeKeys.map(function (k) {
      return '<button type="button" class="layer-size-btn' + (k === selSize ? ' active' : '') + '" data-size="' + k + '">' + sizes[k].label + ' · ' + sizes[k].ml + '</button>';
    }).join('') : '<span class="form-hint">No size set</span>';
    sizeEl.querySelectorAll('.layer-size-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        selSize = b.dataset.size;
        sizeEl.querySelectorAll('.layer-size-btn').forEach(function (x) { x.classList.toggle('active', x === b); });
        renderStack();
      });
    });

    function sizeMl() { return (selSize && sizes[selSize]) ? (parseInt(sizes[selSize].ml, 10) || 0) : 0; }

    function sync() {
      hidden.value = JSON.stringify(state.layers);
      prevEl.innerHTML = buildDrinkPanelSVG(state.layers, TEXMAP, { w: 120, h: 90 });
    }

    function renderStack() {
      if (!state.layers.length) {
        stackEl.innerHTML = '<div class="layer-empty">Drag textures here</div>';
      } else {
        var ml = sizeMl();
        stackEl.innerHTML = state.layers.map(function (l, i) {
          var t = TEXMAP[l.textureSlug] || { baseColor: '#ccc', name: l.textureSlug };
          var mlTxt = ml ? Math.round(l.pct / 100 * ml) + 'ml' : '—';
          return '<div class="layer-row" data-idx="' + i + '">'
            + '<span class="layer-drag" draggable="true">⠿</span>'
            + '<span class="layer-swatch" style="background:' + t.baseColor + ';"></span>'
            + '<span class="layer-name">' + t.name + '</span>'
            + '<input type="range" min="0" max="100" value="' + l.pct + '" class="layer-slider">'
            + '<span class="layer-pct">' + l.pct + '%</span>'
            + '<span class="layer-ml">' + mlTxt + '</span>'
            + '<button type="button" class="layer-remove" title="Remove">×</button>'
            + '</div>';
        }).join('');
      }
      bindRows();
      sync();
    }

    function bindRows() {
      stackEl.querySelectorAll('.layer-row').forEach(function (row) {
        var i = parseInt(row.dataset.idx, 10);
        var slider = row.querySelector('.layer-slider');
        if (slider) slider.addEventListener('input', function () {
          state.layers[i].pct = parseInt(slider.value, 10) || 0;
          row.querySelector('.layer-pct').textContent = state.layers[i].pct + '%';
          var ml = sizeMl();
          row.querySelector('.layer-ml').textContent = ml ? Math.round(state.layers[i].pct / 100 * ml) + 'ml' : '—';
          sync();
        });
        var rm = row.querySelector('.layer-remove');
        if (rm) rm.addEventListener('click', function () { state.layers.splice(i, 1); renderStack(); });
        var handle = row.querySelector('.layer-drag');
        if (handle) handle.addEventListener('dragstart', function (e) { e.dataTransfer.setData('text/plain', 'move:' + i); });
      });
    }

    function dropIndex(y) {
      var rows = [].slice.call(stackEl.querySelectorAll('.layer-row'));
      for (var i = 0; i < rows.length; i++) {
        var r = rows[i].getBoundingClientRect();
        if (y < r.top + r.height / 2) return i;
      }
      return rows.length;
    }

    stackEl.addEventListener('dragover', function (e) { e.preventDefault(); });
    stackEl.addEventListener('drop', function (e) {
      e.preventDefault();
      var data = e.dataTransfer.getData('text/plain') || '';
      var idx = dropIndex(e.clientY);
      if (data.indexOf('add:') === 0) {
        var slug = data.slice(4);
        if (!TEXMAP[slug]) return;
        var used = state.layers.reduce(function (s, l) { return s + l.pct; }, 0);
        var pct = Math.max(5, Math.min(100 - used, 100)) || 20;
        state.layers.splice(idx, 0, { textureSlug: slug, pct: pct });
        renderStack();
      } else if (data.indexOf('move:') === 0) {
        var from = parseInt(data.slice(5), 10);
        if (isNaN(from)) return;
        var item = state.layers.splice(from, 1)[0];
        if (from < idx) idx--;
        state.layers.splice(idx, 0, item);
        renderStack();
      }
    });

    renderStack();
  }
})();
</script>

<%- include('./layout-bottom') %>
