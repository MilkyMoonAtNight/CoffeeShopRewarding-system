<%- include('./layout-top') %>

<div class="admin-page-header">
  <h1 class="admin-page-title">Messages</h1>
  <p class="admin-page-sub">Anonymous messages left through the home-page contact panel<%= unread ? ' · ' + unread + ' unread' : '' %></p>
</div>

<% if (msg) { %>
<div class="admin-alert <%= msg.startsWith('Error') ? 'admin-alert-error' : 'admin-alert-success' %>"><%= msg %></div>
<% } %>

<% if (!messages.length) { %>
  <div class="admin-card"><p class="admin-empty">No messages yet — they'll show up here as visitors send them.</p></div>
<% } else { %>
  <% messages.forEach(m => { %>
  <div class="admin-card msg-card <%= m.read ? '' : 'msg-unread' %>" style="margin-bottom:0.75rem;">
    <div class="msg-head">
      <div style="min-width:0;">
        <div style="display:flex;align-items:center;gap:0.4rem;flex-wrap:wrap;">
          <% if (!m.read) { %><span class="admin-item-tag tag-special">New</span><% } %>
          <strong style="font-size:0.95rem;"><%= m.subject %></strong>
        </div>
        <p style="font-size:0.75rem;color:rgba(44,44,44,0.5);margin-top:0.15rem;">
          <span class="msg-user">👤 <%= m.username || 'Anonymous' %></span> ·
          <%= m.createdAt.toLocaleDateString('en-ZA', { day:'numeric', month:'short', year:'numeric' }) %>,
          <%= m.createdAt.toLocaleTimeString('en-ZA', { hour:'2-digit', minute:'2-digit' }) %>
        </p>
      </div>
      <div style="display:flex;gap:0.4rem;flex-shrink:0;">
        <form action="/admin/messages/<%= m._id %>/read" method="POST" style="display:inline;">
          <button type="submit" class="admin-toggle-btn"><%= m.read ? 'Mark unread' : 'Mark read' %></button>
        </form>
        <form action="/admin/messages/<%= m._id %>/delete" method="POST"
              onsubmit="return confirm('Delete this message?')" style="display:inline;">
          <button type="submit" class="admin-toggle-btn" style="color:#c83232;border-color:#c83232;">Del</button>
        </form>
      </div>
    </div>
    <p class="msg-body"><%= m.details %></p>
  </div>
  <% }) %>
<% } %>

<%- include('./layout-bottom') %>
