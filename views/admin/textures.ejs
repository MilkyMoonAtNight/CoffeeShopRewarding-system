<%- include('./layout-top') %>

<div class="admin-page-header">
  <h1 class="admin-page-title">Textures</h1>
  <p class="admin-page-sub">The colour library used to build drink panels. Drinks reference these by name, so recolouring one updates every drink that uses it.</p>
</div>

<% if (msg) { %>
<div class="admin-alert <%= msg.startsWith('Error') ? 'admin-alert-error' : 'admin-alert-success' %>"><%= msg %></div>
<% } %>

<div class="admin-two-col">

  <!-- Add texture -->
  <div class="admin-card">
    <h3 class="admin-card-title">Add New Texture</h3>
    <form action="/admin/textures/add" method="POST" class="auth-form">
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" required maxlength="60" placeholder="e.g. Caramel" />
      </div>
      <div class="form-group">
        <label>Base colour</label>
        <div class="tex-color-row">
          <input type="color" name="baseColor" value="#C4845C" class="tex-color-input" />
          <span class="form-hint">The tint for this layer.</span>
        </div>
      </div>
      <div class="form-group" style="flex-direction:row;align-items:center;gap:0.5rem;">
        <input type="checkbox" name="dots" id="addDots" style="width:auto;" />
        <label for="addDots" style="margin:0;font-size:0.85rem;">Overlay small dots (e.g. Milk)</label>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
        <div class="form-group">
          <label>Dot colour</label>
          <input type="color" name="dotColor" value="#9a9a9a" class="tex-color-input" />
        </div>
        <div class="form-group">
          <label>Dot density (1–10)</label>
          <input type="number" name="dotDensity" value="4" min="1" max="10" class="scan-input" />
        </div>
      </div>
      <input type="hidden" name="order" value="99" />
      <button type="submit" class="btn btn-primary btn-full">Add Texture</button>
    </form>
  </div>

  <!-- Texture list -->
  <div>
    <% if (!textures.length) { %>
      <div class="admin-card"><p class="admin-empty">No textures yet.</p></div>
    <% } else { %>
      <% textures.forEach(tex => { %>
      <div class="admin-card admin-drink-row" style="margin-bottom:0.75rem;">
        <div style="display:flex;gap:1rem;align-items:center;">
          <div class="tex-swatch" style="background:<%= tex.baseColor %>;">
            <% if (tex.dots) { %><span class="tex-swatch-dots" style="--dc:<%= tex.dotColor %>;"></span><% } %>
          </div>
          <div style="flex:1;min-width:0;">
            <strong style="font-size:0.92rem;"><%= tex.name %></strong>
            <p style="font-size:0.75rem;color:rgba(44,44,44,0.45);margin-top:0.1rem;">
              <%= tex.baseColor %><%= tex.dots ? ' · dotted' : '' %> · <code style="font-size:0.7rem;"><%= tex.slug %></code>
            </p>
          </div>
          <div style="display:flex;gap:0.4rem;flex-shrink:0;">
            <button onclick="toggleEdit('tedit-<%= tex._id %>')" class="admin-toggle-btn">Edit</button>
            <form action="/admin/textures/delete/<%= tex._id %>" method="POST"
                  onsubmit="return confirm('Delete texture <%= tex.name %>? Drinks using it will lose that layer.')" style="display:inline;">
              <button type="submit" class="admin-toggle-btn" style="color:#c83232;border-color:#c83232;">Del</button>
            </form>
          </div>
        </div>

        <!-- Inline edit -->
        <div id="tedit-<%= tex._id %>" style="display:none;margin-top:1rem;padding-top:1rem;border-top:1px solid rgba(44,44,44,0.08);">
          <form action="/admin/textures/edit/<%= tex._id %>" method="POST">
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
              <div class="form-group" style="grid-column:span 2;">
                <label>Name</label>
                <input type="text" name="name" value="<%= tex.name %>" required maxlength="60" class="scan-input" />
              </div>
              <div class="form-group">
                <label>Base colour</label>
                <input type="color" name="baseColor" value="<%= tex.baseColor %>" class="tex-color-input" />
              </div>
              <div class="form-group">
                <label>Dot colour</label>
                <input type="color" name="dotColor" value="<%= tex.dotColor || '#9a9a9a' %>" class="tex-color-input" />
              </div>
              <div class="form-group" style="flex-direction:row;align-items:center;gap:0.5rem;">
                <input type="checkbox" name="dots" id="ed-<%= tex._id %>" style="width:auto;" <%= tex.dots ? 'checked' : '' %> />
                <label for="ed-<%= tex._id %>" style="margin:0;font-size:0.85rem;">Dots</label>
              </div>
              <div class="form-group">
                <label>Dot density (1–10)</label>
                <input type="number" name="dotDensity" value="<%= tex.dotDensity || 5 %>" min="1" max="10" class="scan-input" />
              </div>
              <input type="hidden" name="order" value="<%= tex.order %>" />
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:0.75rem;width:100%;">Save Changes</button>
          </form>
        </div>
      </div>
      <% }) %>
    <% } %>
  </div>

</div>

<script>
function toggleEdit(id) {
  const el = document.getElementById(id);
  el.style.display = el.style.display === 'none' ? 'block' : 'none';
}
</script>

<%- include('./layout-bottom') %>
